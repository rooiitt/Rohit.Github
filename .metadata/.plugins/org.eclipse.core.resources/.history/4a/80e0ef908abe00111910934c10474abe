package com.kodewala.array;

public class GamingPC {
		
		int soap;
		String water;
		
		public GamingPC(int soap, String water) {
			super();
			this.soap = soap;
			this.water = water;
		}
		
		public static void main(String[] args) {
			
			GamingPC filled1 = new GamingPC(3 , " 4 liter");
			GamingPC filled2= new GamingPC(5 , " 5 liter");
			GamingPC filled3= new GamingPC(2 , " 6 liter");
			GamingPC filled4= new GamingPC(1 , " 7 liter");
			
			GamingPC filleds[] =  new GamingPC[4];
			
			filleds[0] = filled1;
			filleds[1] = filled2;
			filleds[2] = filled3;
			filleds[3] = filled4;
			
			for(int i = 0; i<filleds.length; i++) {
				System.out.println(filleds[i].soap + " , " + filleds[i].water);
			
		}
		
	}
}



