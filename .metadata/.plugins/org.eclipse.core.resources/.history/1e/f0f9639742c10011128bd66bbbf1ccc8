package com.kodewala.switch1;

public class Ecommerce {

	public static void main(String[] args) {
		Ecommerce em = new Ecommerce();
		int discount = Integer.parseInt(args [0]);
		
		em.customer(discount);
		
	}
	
	public void customer(int number) {
		
		switch (number) {
		case 1:
			 System.out.println("Gold customer....20% discount");
			break;
		case 2:
			 System.out.println("Silver customer....10% discount");
			break;
		case 3:
			 System.out.println("Regular....5% discount");
			break;
		

		default:
			System.out.println("please enter the jwellary");
			break;
		}
		
		

	}

}
