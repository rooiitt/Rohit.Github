package com.kodewala.scanner;

import java.util.Scanner;

public class Scaner2 {

	public static void main(String[] args) {
	
		Scanner sc = new Scanner(System.in); // Creating Connectin with Console
		
		System.out.println("Please enter your name..");
		String name = sc.nextLine();
		
		System.out.println("Please enter your marks..");
		int marks = sc.nextInt();
		
		sc.nextLine(); // (IMPORTANT) After integer if you are consuming string nothing will come tw we have to use 
		
		System.out.println("Higest scoring subject");
		String subject = sc.nextLine();
		
		System.out.println("Name is : " + name);
		System.out.println("Name is : " + marks);
		System.out.println("Name is : " + subject);
		
		sc.close();
		
	}

}
