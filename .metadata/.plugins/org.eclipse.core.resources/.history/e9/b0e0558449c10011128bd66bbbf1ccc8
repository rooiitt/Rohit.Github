package com.kodewala.switch1;

public class Switch {

	public static void main(String[] args) {
		Switch swi = new Switch(); 
		int day = Integer.parseInt(args[0]);
		
		swi.identifyday(day);

	}
	public void identifyday(int number) {
		
		switch (number) {
		case 1 : 
			System.out.println("MON");
			break;
		case 2 : 
			System.out.println("TUE");
			break;
		case 3 : 
			System.out.println("WED");
			break;
		case 4 : 
			System.out.println("TH");
			break;
		case 5 : 
			System.out.println("FR");
			break;
		case 6 : 
			System.out.println("SATcalc");
			break;
			
			default:
				System.out.println("Please entyer the valid number...");
				break;
		}		
	}

}
