package com.kodewala.switch1;

public class FoodDelivery {

	public static void main(String[] args)
	{
		double discount = calculateDiscount("Primium", 600);
		System.out.println("Discount : " + discount);
		

	}
	public static double calculateDiscount(String coustomerType , double amount)
	{
		double discount = 0;
		
		if(amount > 500) {
			switch (coustomerType) {
			
			case "Primium": 
			discount = amount * 15 / 100;
			break;
			
			case "Regular": 
			discount = amount * 10 / 100;
			break;
				
			case "New": 
			discount = amount * 5 / 100;
			break;

			default:
				System.out.println("Please enter ge valid customer type : ");
				
				//break;
			}
			if (discount > 500) {
				discount = 500;
			}
			else {
				System.out.println("Minimum Order should be above 500 : ");
			}
			
		}
		return discount;
		
	}
}
	


