	public static double calculateDiscount(String coustomerType , double amount)
	{
		double discount = 0;
		
		//if(amount) {
			switch (coustomerType) {
			
			case "Primium": 
			discount = amount * 15 / 100;
			break;
			
			case "Regular": 
			discount = amount * 10 / 100;
			break;
				
			case "New": 
			discount = amount * 5 / 100;
			break;

			default:
				
				break;
			}
			if (discount > 500) {
				discount = 1000;
			}
			else {
				System.out.println("Minimum Order should be 500 : ");
			}
			return discount;
			
		}
		
	}

}
