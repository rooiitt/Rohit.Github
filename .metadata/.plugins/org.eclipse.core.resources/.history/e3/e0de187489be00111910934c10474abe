package com.kodewala.array;

public class Bucket {
		
		int soap;
		String water;
		
		public Bucket(int soap, String water) {
			super();
			this.soap = soap;
			this.water = water;
		}
		
		public static void main(String[] args) {
			
			Bucket filled1 = new Bucket(3 , " 4 liter");
			Bucket filled2= new Bucket(5 , " 5 liter");
			Bucket filled3= new Bucket(2 , " 6 liter");
			Bucket filled4= new Bucket(1 , " 7 liter");
			
			Bucket filleds[] =  new Bucket[4];
			
			filleds[0] = filled1;
			filleds[1] = filled2;
			filleds[2] = filled3;
			filleds[3] = filled4;
			
			System.out.println(filleds[3]);
			
		}
		
	}



